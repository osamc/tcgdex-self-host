# Image published at https://hub.docker.com/r/tcgdex/server
TCGDEX_IMAGE=tcgdex/server:edge

# Worker processes inside the TCGdex container. The upstream default is one per CPU.
MAX_WORKERS=2

# How long the manager caches upstream JSON (seconds). Custom cards apply on top of this cache.
UPSTREAM_CACHE_TTL=300

# Management UI and API token. The public card API does not use this token.
# Generate one with: openssl rand -hex 24
MANAGEMENT_TOKEN=replace-with-a-long-random-token

# Local bind for the manager. Existing Caddy on the host should proxy to this address.
# Use 127.0.0.1 so the API is not published on the LAN except through Caddy.
MANAGER_BIND=127.0.0.1
MANAGER_PORT=8080

# Docker network your existing Caddy container already uses.
# Only required when you start the stack with docker-compose.caddy.yml.
CADDY_NETWORK=caddy

# Hostname Caddy should serve. Read by caddy/tcgdex.caddy, not by Compose.
TCGDEX_HOST=tcgdex.example.com

# Where Caddy sends traffic.
# Docker Caddy on CADDY_NETWORK: tcgdex-manager:8080
# Caddy installed on the host:    127.0.0.1:8080
TCGDEX_UPSTREAM=tcgdex-manager:8080
